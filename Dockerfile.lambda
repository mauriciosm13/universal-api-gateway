# syntax=docker/dockerfile:1

# Build stage — same as production Dockerfile
FROM golang:1.25-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w" -o /gateway ./cmd/gateway

# Runtime — AWS Lambda Web Adapter (see ADR 0003)
FROM public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1

COPY --from=builder /gateway /gateway

ENV PORT=8080
ENV AWS_LWA_READINESS_CHECK_PATH=/health/ready
ENV GATEWAY_HOST=0.0.0.0
ENV GATEWAY_PORT=8080

CMD ["/gateway"]
