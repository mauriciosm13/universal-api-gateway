{
  "name": "universal-api-gateway",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.25-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false
      }
    }
  },
  "forwardPorts": [8080],
  "postCreateCommand": "go mod download",
  "remoteUser": "vscode"
}
